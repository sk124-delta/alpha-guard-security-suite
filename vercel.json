{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/(.*)", "destination": "/api/index" },
    { "src": "/(.*)", "destination": "/$1" }
  ],
  "crons": [
    { "path": "/api/v1/cron/scan", "schedule": "0 6 * * *" }
  ]
}
