{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|v1/).*)",
      "destination": "/index.html"
    }
  ]
}
{
  "version": 2
}