# DMCA and account emails use the Resend HTTP API, not SMTP.
RESEND_API_KEY=
SENDER_LEGAL_EMAIL=

# Optional fallback sender used by other Resend email flows.
RESEND_FROM_EMAIL=

# Set to true to send DMCA notices automatically for matches of 90% or higher
# (only when the recipient was supplied in the request; WHOIS-derived recipients
# always stay PENDING for admin review). Off by default.
AUTO_DISPATCH_DMCA=false
# Every send (confirmed or automatic) writes rows to the dmca_notice_audit_log table.
# TODO(legal): have a qualified lawyer review the automated DMCA workflow before enabling this.
